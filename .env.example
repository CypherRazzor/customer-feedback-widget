# ─────────────────────────────────────────────────────────────────────────────
# customer-feedback-widget – Environment Variables
#
# Copy this file to .env and fill in every value before first boot.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (Hetzner KonsoleH) ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@hetzner-host:5432/dbname

# ── Hetzner Object Storage (S3-compatible) ────────────────────────────────────
HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_S3_REGION=eu-central-1
HETZNER_S3_BUCKET=feedback-screenshots
HETZNER_S3_ACCESS_KEY=your-access-key
HETZNER_S3_SECRET_KEY=your-secret-key
# Public base URL for uploaded screenshots (CDN or direct bucket URL)
HETZNER_S3_PUBLIC_URL=https://feedback-screenshots.fsn1.your-objectstorage.com

# ── Preview Token Auth ─────────────────────────────────────────────────────────
# HMAC secret for signing/verifying preview tokens
PREVIEW_TOKEN_SECRET=change-me-random-32chars-preview-token

# ── Admin Auth ────────────────────────────────────────────────────────────────
# Static admin token for /admin routes (replace with Better Auth in production)
ADMIN_SECRET=change-me-admin-secret

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://feedback.example.com
NEXT_PUBLIC_PREVIEW_MODE=true
